# Copie para .env e preencha. NUNCA commitar o .env real.

# Supabase (banco + auth + storage)
# SUPABASE_ANON_KEY: use a "Publishable key" (sb_publishable_...) em
# Settings -> API Keys. A "anon key" legada também funciona, mas será
# aposentada pelo Supabase até o fim de 2026.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Conexão direta PostgreSQL (SQLAlchemy) — usar pooler do Supabase
# Copie a string exata do dashboard (botão Connect): o host varia por projeto
# (ex.: aws-1-sa-east-1). Caracteres especiais na senha devem ser
# percent-encoded na URL (# -> %23, / -> %2F, @ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres.SEU-PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# App
ULTRAERP_DEBUG=false
